    "def calculate_difference(df, column_A, column_B):\n",
    "    # Replace zeros in the denominator with NaN\n",
    "    df[column_B] = df[column_B].replace(0, np.nan)\n",
    "\n",
    "    # Calculate the difference in height\n",
    "    difference = df[column_A] - df[column_B]\n",
    "\n",
    "    # Calculate the percentage difference\n",
    "    difference_percentage = (difference / df[column_B]) * 100\n",
    "\n",
    "    return difference_percentage\n",
    "\n",
    "# standardize the values for out input, we will represent the differences as a percentage\n",
    "# if x > 0, A had a higher value, else B had a higher value\n",
    "result_df['averageControlTimeRatio'] = calculate_difference(result_df, 'averageControlTimeA', 'averageControlTimeB')\n",
    "result_df['winPercentageRatio'] = calculate_difference(result_df,'winPercentageA', 'winPercentageB')\n",
    "result_df['averageFightTimeRatio'] = calculate_difference(result_df,'averageFightTimeA', 'averageFightTimeB')\n",
    "result_df['ageRatio'] = calculate_difference(result_df,'ageA', 'ageB')\n",
    "result_df['finishRateRatio'] = calculate_difference(result_df,'finishRateA', 'finishRateB')\n",
    "result_df['strikeDifferentialRatio'] = calculate_difference(result_df,'strikeDifferentialA', 'strikeDifferentialB')\n",
    "result_df['takedownDifferentialRatio'] = calculate_difference(result_df,'takedownDifferentialA', 'takedownDifferentialB')\n",
    "result_df['weightClass'] = result_df['weightClassA']\n",
    "result_df['unbeatenStreakRatio'] = calculate_difference(result_df,'winStreakA', 'winStreakB')\n",
    "result_df['controlPercentageRatio'] = calculate_difference(result_df,'controlPercentageA', 'controlPercentageB')\n",
    "result_df['numberOfFightsRatio'] = calculate_difference(result_df,'numberOfFightsA', 'numberOfFightsB')\n",
    "\n",
    "test = result_df.drop(columns=['averageControlTimeA', 'averageControlTimeB', 'winPercentageA', 'winPercentageB', \n",
    "                                    'averageFightTimeA', 'averageFightTimeB', 'ageA', 'ageB', \n",
    "                                    'strikeDifferentialA', 'strikeDifferentialB', 'takedownDifferentialA', 'takedownDifferentialB', \n",
    "                                    'weightClassA', 'weightClassB', 'winStreakA', 'winStreakB', 'controlPercentageA', 'controlPercentageB',\n",
    "                                    'numberOfFightsA', 'numberOfFightsB'])"
   ]
